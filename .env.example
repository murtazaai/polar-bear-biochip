# polar-bear-biochip - environment variable template
# Copy to .env and fill in real values.
# NEVER commit the .env file - it is gitignored.

# ── AI Agent (Rig / ARC) ──────────────────────────────────────────────────────
# Required only for --features ai-agent builds
ANTHROPIC_API_KEY=

# ── Model selection ───────────────────────────────────────────────────────────
# Anthropic model for live LLM inference (default: claude-sonnet-4-6)
BIOCHIP_MODEL=claude-sonnet-4-6

# ── Pipeline tuning ───────────────────────────────────────────────────────────
# Number of inference cycles per run (0 = infinite)
BIOCHIP_CYCLES=5

# Output directory for signed JSON provenance records
BIOCHIP_OUTPUT_DIR=signed_outputs

# ── Dry-run / demo mode ───────────────────────────────────────────────────────
# Set to "true" to skip live LLM calls and use deterministic demo responses.
# Automatically activated when ANTHROPIC_API_KEY is absent.
BIOCHIP_DEMO=false
