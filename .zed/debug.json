[
  {
    "label": "Clean polar-bear-biochip",
    "build": {
      "command": "cargo",
      "args": ["clean"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-biochip",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Build & Debug polar-bear-biochip",
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-biochip",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Release Build & Debug polar-bear-biochip",
    "build": {
      "command": "cargo",
      "args": ["build", "--release"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/release/polar-bear-biochip",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
